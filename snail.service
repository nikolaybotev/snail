[Unit]
Description=Snail IMAP IDLE daemon
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/ABS/PATH/TO/HOME/snail/scripts/run-service.sh /ABS/PATH/TO/node /ABS/PATH/TO/HOME/snail/snail.js --config /ABS/PATH/TO/HOME/.config/snail/config.toml
Restart=on-failure
RestartPreventExitStatus=2
RestartSec=10
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=default.target
